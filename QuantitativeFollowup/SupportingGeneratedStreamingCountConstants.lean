module
public import QuantitativeFollowup.SupportingGeneratedForestLeafCounts

@[expose] public section

/-! Arithmetic constants for the actual source-family induction. These
lemmas alone make no claim that a family was generated by streaming: its
construction, order support and aggregate budget are separate obligations. -/
noncomputable section
open scoped ENNReal
namespace QuantitativeFollowup
set_option autoImplicit false
set_option maxHeartbeats 500000

def printedGeneratedOriginAppendCost (K m : ℕ) : ℕ := K+(K-1)*m

def printedGeneratedStreamingStepCost (K m : ℕ) : ℕ :=
  K^2+K*(printedGeneratedOriginAppendCost K m)^2+4*K*printedGeneratedOriginAppendCost K m+K

def printedGeneratedStreamingLeafBound (K0 r : ℕ) : ℕ := K0+2*r

def printedGeneratedStreamingMarkBound (r : ℕ) : ℕ := 2*r+1

def printedGeneratedStreamingBudget (K0 : ℕ) : ℕ → ℕ
  | 0 => 1
  | r+1 => printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
      (printedGeneratedStreamingMarkBound r)*printedGeneratedStreamingBudget K0 r

def printedGeneratedStreamingCubicConstant (K0 r : ℕ) : ℕ :=
  printedGeneratedStreamingMarkBound r*printedGeneratedStreamingBudget K0 r

theorem printedGeneratedOriginAppendCost_mono {K L m M : ℕ} (hK : K ≤ L) (hm : m ≤ M) :
    printedGeneratedOriginAppendCost K m ≤ printedGeneratedOriginAppendCost L M := by
  exact Nat.add_le_add hK (Nat.mul_le_mul (Nat.sub_le_sub_right hK 1) hm)

theorem printedGeneratedStreamingStepCost_mono {K L m M : ℕ} (hK : K ≤ L) (hm : m ≤ M) :
    printedGeneratedStreamingStepCost K m ≤ printedGeneratedStreamingStepCost L M := by
  have hA := printedGeneratedOriginAppendCost_mono hK hm
  unfold printedGeneratedStreamingStepCost
  gcongr

theorem printedGeneratedStreamingLeafBound_mono {K L r s : ℕ} (hK : K ≤ L) (hr : r ≤ s) :
    printedGeneratedStreamingLeafBound K r ≤ printedGeneratedStreamingLeafBound L s := by
  exact Nat.add_le_add hK (Nat.mul_le_mul_left 2 hr)

theorem printedGeneratedStreamingMarkBound_mono {r s : ℕ} (hr : r ≤ s) :
    printedGeneratedStreamingMarkBound r ≤ printedGeneratedStreamingMarkBound s := by
  exact Nat.add_le_add_right (Nat.mul_le_mul_left 2 hr) 1

theorem printedGeneratedStreamingLeafBound_succ (K0 r : ℕ) :
    printedGeneratedStreamingLeafBound K0 (r+1) = printedGeneratedStreamingLeafBound K0 r+2 := by
  unfold printedGeneratedStreamingLeafBound
  omega

theorem printedGeneratedStreamingMarkBound_succ (r : ℕ) :
    printedGeneratedStreamingMarkBound (r+1) = printedGeneratedStreamingMarkBound r+2 := by
  unfold printedGeneratedStreamingMarkBound
  omega

theorem printedGeneratedStreamingMarkBound_pos (r : ℕ) :
    0 < printedGeneratedStreamingMarkBound r := by
  unfold printedGeneratedStreamingMarkBound
  omega

theorem printedGeneratedStreamingBudget_zero (K0 : ℕ) : printedGeneratedStreamingBudget K0 0 = 1 := rfl

theorem printedGeneratedStreamingBudget_succ (K0 r : ℕ) :
    printedGeneratedStreamingBudget K0 (r+1) =
      printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
        (printedGeneratedStreamingMarkBound r)*printedGeneratedStreamingBudget K0 r := rfl

theorem printedGeneratedStreamingStepCost_at_stage {K0 K m r : ℕ}
    (hK : K ≤ printedGeneratedStreamingLeafBound K0 r)
    (hm : m ≤ printedGeneratedStreamingMarkBound r) :
    printedGeneratedStreamingStepCost K m ≤
      printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
        (printedGeneratedStreamingMarkBound r) := printedGeneratedStreamingStepCost_mono hK hm

theorem printedGeneratedOriginAppendCost_ennreal (K m : ℕ) :
    (printedGeneratedOriginAppendCost K m : ℝ≥0∞) =
      (K : ℝ≥0∞)+(K-1 : ℕ)*(m : ℝ≥0∞) := by
  simp only [printedGeneratedOriginAppendCost,Nat.cast_add,Nat.cast_mul]

theorem printedGeneratedStreamingStepCost_ennreal (K m : ℕ) :
    (printedGeneratedStreamingStepCost K m : ℝ≥0∞) =
      (K : ℝ≥0∞)^2+(K : ℝ≥0∞)*(printedGeneratedOriginAppendCost K m : ℝ≥0∞)^2+
        4*(K : ℝ≥0∞)*(printedGeneratedOriginAppendCost K m : ℝ≥0∞)+(K : ℝ≥0∞) := by
  simp only [printedGeneratedStreamingStepCost,Nat.cast_add,Nat.cast_mul,Nat.cast_pow,Nat.cast_ofNat]

theorem printedGeneratedStreamingBudget_succ_ennreal (K0 r : ℕ) :
    (printedGeneratedStreamingBudget K0 (r+1) : ℝ≥0∞) =
      (printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
        (printedGeneratedStreamingMarkBound r) : ℝ≥0∞)*
          (printedGeneratedStreamingBudget K0 r : ℝ≥0∞) := by
  rw [printedGeneratedStreamingBudget_succ,Nat.cast_mul]

theorem printedGeneratedStreamingCubicConstant_ennreal (K0 r : ℕ) :
    (printedGeneratedStreamingCubicConstant K0 r : ℝ≥0∞) =
      (printedGeneratedStreamingMarkBound r : ℝ≥0∞)*(printedGeneratedStreamingBudget K0 r : ℝ≥0∞) := by
  rw [printedGeneratedStreamingCubicConstant,Nat.cast_mul]

theorem printedGeneratedStreamingBudget_ofReal (K0 r : ℕ) :
    ENNReal.ofReal (printedGeneratedStreamingBudget K0 r : ℝ) =
      (printedGeneratedStreamingBudget K0 r : ℝ≥0∞) := by simp

theorem printedGeneratedStreamingCubicConstant_ofReal (K0 r : ℕ) :
    ENNReal.ofReal (printedGeneratedStreamingCubicConstant K0 r : ℝ) =
      (printedGeneratedStreamingCubicConstant K0 r : ℝ≥0∞) := by simp

theorem printedGeneratedStreamingBudget_ne_top (K0 r : ℕ) :
    (printedGeneratedStreamingBudget K0 r : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _

theorem printedGeneratedStreamingCubicConstant_ne_top (K0 r : ℕ) :
    (printedGeneratedStreamingCubicConstant K0 r : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top _

theorem printedGeneratedStreamingBudget_le_uniform_power (K0 r : ℕ) :
    printedGeneratedStreamingBudget K0 r ≤
      (printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
        (printedGeneratedStreamingMarkBound r))^r := by
  induction r with
  | zero => simp only [printedGeneratedStreamingBudget_zero,pow_zero,le_refl]
  | succ r ih =>
      let B := printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 (r+1))
        (printedGeneratedStreamingMarkBound (r+1))
      have hs : printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
          (printedGeneratedStreamingMarkBound r) ≤ B :=
        printedGeneratedStreamingStepCost_mono
          (printedGeneratedStreamingLeafBound_mono le_rfl (Nat.le_succ r))
          (printedGeneratedStreamingMarkBound_mono (Nat.le_succ r))
      rw [printedGeneratedStreamingBudget_succ]
      calc
        _ ≤ B*B^r := Nat.mul_le_mul hs (ih.trans (Nat.pow_le_pow_left hs r))
        _ = B^(r+1) := by rw [pow_succ]; exact Nat.mul_comm _ _

theorem printedGeneratedStreamingCubicConstant_le_uniform_power (K0 r : ℕ) :
    printedGeneratedStreamingCubicConstant K0 r ≤
      printedGeneratedStreamingMarkBound r*
        (printedGeneratedStreamingStepCost (printedGeneratedStreamingLeafBound K0 r)
          (printedGeneratedStreamingMarkBound r))^r :=
  Nat.mul_le_mul_left _ (printedGeneratedStreamingBudget_le_uniform_power K0 r)

end QuantitativeFollowup
