module
public import QuantitativeFollowup.ScalarSpinConditional

@[expose] public section

/-! The actual filtration generated by the scalar diffusion observations.
The conditional-spin identity is transferred from the Brownian past by
the genuine conditional tower and measurability of the present gradient. -/
noncomputable section
open Set MeasureTheory ProbabilityTheory Paper FRSB FourPapersCommon
open scoped NNReal Topology
namespace QuantitativeFollowup
set_option maxHeartbeats 1200000
set_option synthInstance.maxHeartbeats 200000
set_option backward.isDefEq.respectTransparency false

def scalarObservedPast (β : ℝ) (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    MeasurableSpace (Paper.BrownianSample×Bool) :=
  ⨆r : {r : Paper.Overlap // r ≤ q},
    (borel ℝ).comap (fun z=>parisiPhysicalSplitState β 0 μ r.val z.1)

theorem scalarObservedPast_le_brownian (β : ℝ) (hβ : β ≠ 0)
    (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    scalarObservedPast β μ q ≤ scalarSpinPast (q : ℝ).toNNReal := by
  apply iSup_le
  intro r
  have hr : (r.val : ℝ).toNNReal ≤ (q : ℝ).toNNReal := by
    exact Real.toNNReal_le_toNNReal r.property
  have hm := (measurable_parisiPhysicalSplitState_past β 0 hβ μ r.val).mono
    (canonicalBrownianFiltration.mono hr) le_rfl
  exact (hm.comp (comap_measurable Prod.fst)).comap_le

theorem scalarObservedPast_le (β : ℝ) (hβ : β ≠ 0)
    (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    scalarObservedPast β μ q ≤
      (inferInstance : MeasurableSpace (Paper.BrownianSample×Bool)) :=
  (scalarObservedPast_le_brownian β hβ μ q).trans (scalarSpinPast_le _)

theorem measurable_scalarObservedState (β : ℝ) (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    Measurable[scalarObservedPast β μ q]
      (fun z : Paper.BrownianSample×Bool=>parisiPhysicalSplitState β 0 μ q z.1) := by
  exact (comap_measurable (fun z : Paper.BrownianSample×Bool=>parisiPhysicalSplitState β 0 μ q z.1)).mono
    (le_iSup_of_le ⟨q,le_rfl⟩ le_rfl) le_rfl

theorem measurable_scalarM_observed (β : ℝ) (hβ : β ≠ 0)
    (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    Measurable[scalarObservedPast β μ q] (fun z : Paper.BrownianSample×Bool=>M β μ q z.1) := by
  have he : (fun z : Paper.BrownianSample×Bool=>M β μ q z.1)=
      fun z=>parisiGradient β μ (q,parisiPhysicalSplitState β 0 μ q z.1) :=
    funext fun z=>(scalarGradient_physicalSplitState β hβ μ q z.1).symm
  rw [he]
  exact (continuous_parisiGradient β μ).measurable.comp
    (measurable_const.prodMk (measurable_scalarObservedState β μ q))

theorem scalarMarkedSpinLaw_sign_condExp_observed (β : ℝ) (hβ : β ≠ 0)
    (μ : Paper.ParisiMeasure) (q : Paper.Overlap) :
    (scalarMarkedSpinLaw β hβ μ)[(fun z=>Paper.spinSign z.2) |
      scalarObservedPast β μ q] =ᵐ[scalarMarkedSpinLaw β hβ μ]
        fun z=>M β μ q z.1 := by
  have hi := (scalarMarkedSpinLaw_memLp_lift β hβ μ _
    (scalar_M_memLp_two β μ q q.property)).integrable (by norm_num)
  have ht := condExp_condExp_of_le (μ:=scalarMarkedSpinLaw β hβ μ)
    (f:=fun z : Paper.BrownianSample×Bool=>Paper.spinSign z.2)
    (scalarObservedPast_le_brownian β hβ μ q) (scalarSpinPast_le (q : ℝ).toNNReal)
  have hc := condExp_congr_ae (m:=scalarObservedPast β μ q)
    (scalarMarkedSpinLaw_sign_condExp β hβ μ q)
  exact ht.symm.trans (hc.trans (by
    rw [condExp_of_stronglyMeasurable (scalarObservedPast_le β hβ μ q)
      (measurable_scalarM_observed β hβ μ q).stronglyMeasurable hi]))

end QuantitativeFollowup
